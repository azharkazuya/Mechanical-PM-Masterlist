rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'azharkazuya@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Helpers ---
    function isValidPMItem(data) {
      return data.keys().hasAll(['id', 'domain', 'pm_no', 'machine', 'pic', 'engineer', 'frequency']) &&
        data.keys().hasOnly(['id', 'domain', 'sheet', 'category', 'pm_no', 'location', 'section', 'machine', 'pic', 'engineer', 'check_sheet', 'frequency', 'scheduled_weeks', 'weeks_detail', 'updatedAt', 'updatedBy']) &&
        data.id is int && data.id > 0 &&
        data.domain is string && data.domain.size() <= 64 &&
        data.pm_no is string && data.pm_no.size() <= 64 &&
        data.machine is string && data.machine.size() <= 256 &&
        data.pic is string && data.pic.size() <= 64 &&
        data.engineer is string && data.engineer.size() <= 64 &&
        data.frequency is string && data.frequency.size() <= 64;
    }

    function isValidExecutionRecord(data) {
      return data.keys().hasAll(['id', 'itemId', 'weekNumber', 'status']) &&
        data.keys().hasOnly(['id', 'itemId', 'weekNumber', 'status', 'note', 'updatedAt', 'updatedBy']) &&
        data.id is string && isValidId(data.id) &&
        data.itemId is int && data.itemId > 0 &&
        data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52 &&
        (data.status in ['scheduled', 'completed', 'in_progress', 'deferred']) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('role' in data) || (data.role in ['engineer', 'pic', 'viewer', 'admin']));
    }

    // --- Collections ---

    // 1. Connection Test Probe
    match /test/{testId} {
      allow get: if true;
      allow write: if false;
    }

    // 2. Master PM Routine Items
    match /pm_items/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) && isValidPMItem(incoming());
      allow delete: if isSignedIn();
    }

    // 3. Execution Records (Weekly maintenance completions)
    match /execution_records/{recordId} {
      allow get, list: if true;
      allow create, update: if isValidId(recordId) && isValidExecutionRecord(incoming());
      allow delete: if isSignedIn();
    }

    // 4. Plant User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming()) &&
        (!('role' in incoming()) || incoming().role != 'admin' || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming()) &&
        (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
